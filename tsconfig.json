{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "types": [
      "node",
      "@testing-library/jest-dom",
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "vitest.setup.ts",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
